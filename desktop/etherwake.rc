// Resources for Etherwake.exe. Compile from the desktop folder so the relative paths resolve.
#include <windows.h>
#include "resource.h"

IDI_APP ICON "etherwake.ico"
IDR_GAME RCDATA "build/game.html"  // build.ps1 puts the page to embed here: the shareable release page, or the full one with -Dev
IDR_MUSIC RCDATA "../music/spaceify.webm"
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "etherwake.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "Alex's Studio"
      VALUE "FileDescription", "Etherwake"
      VALUE "FileVersion", "1.0.0"
      VALUE "InternalName", "Etherwake"
      VALUE "LegalCopyright", "Alex's Studio"
      VALUE "OriginalFilename", "Etherwake.exe"
      VALUE "ProductName", "Etherwake"
      VALUE "ProductVersion", "1.0.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
